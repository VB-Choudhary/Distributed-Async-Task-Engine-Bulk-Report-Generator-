# Environment variables — copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed to source control.

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the HTTP server listens on.
# Type: integer, 1–65535
# Default: 3000
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────

# Minimum log level emitted by pino.
# Allowed: fatal | error | warn | info | debug | trace | silent
# Default: info
LOG_LEVEL=info

# ── Runtime ───────────────────────────────────────────────────────────────────

# Controls development vs production behaviour (e.g., pretty-print logs,
# whether stack traces appear in error responses).
# Allowed: development | production | test
# Default: development
NODE_ENV=development

# ── Coming in future phases ───────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/reports
# REDIS_URL=redis://localhost:6379
# REPORTS_DIR=./reports
# WORKER_CONCURRENCY=4
