# Environment variables — copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed to source control.

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the HTTP server listens on.
# Type: integer, 1–65535
# Default: 3000
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────

# Minimum log level emitted by pino.
# Allowed: fatal | error | warn | info | debug | trace | silent
# Default: info
LOG_LEVEL=info

# ── Runtime ───────────────────────────────────────────────────────────────────

# Controls development vs production behaviour (e.g., pretty-print logs,
# whether stack traces appear in error responses).
# Allowed: development | production | test
# Default: development
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# Full PostgreSQL connection string used by the application pool (pg).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Default: postgresql://postgres:postgres@localhost:5432/reports
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reports

# Credentials used by docker-compose for the postgres service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reports

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection string used for caching and BullMQ job queue.
# Format: redis://[user]:[password]@[host]:[port]
# Default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Coming in future phases ───────────────────────────────────────────────────
# REPORTS_DIR=./reports
# WORKER_CONCURRENCY=4
