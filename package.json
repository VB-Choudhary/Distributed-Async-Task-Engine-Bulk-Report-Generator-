{
  "name": "report-generator",
  "version": "0.1.0",
  "description": "Bulk Invoice & PDF Report Generator – async job-processing system",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsup src/api/server.ts --format cjs --out-dir dist --clean",
    "start": "node dist/server.js",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
